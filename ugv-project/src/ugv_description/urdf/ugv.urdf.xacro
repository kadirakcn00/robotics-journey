<?xml version="1.0"?>
<!--
  UGV robot modeli (xacro).
  Olculer asagidaki property'lerden degistirilebilir; atalet degerleri otomatik hesaplanir.
  Kontrol:  xacro ugv.urdf.xacro > /tmp/ugv.urdf && check_urdf /tmp/ugv.urdf
-->
<robot name="ugv" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- DiffDrive'in dinledigi hiz topic'i. Parkurda su fizigi node'u araya girer:
       /cmd_vel -> water_physics -> /cmd_vel_gz -> Gazebo -->
  <xacro:arg name="cmd_vel_topic" default="/cmd_vel"/>

  <!-- ================= Olculer (metre / kg) ================= -->
  <xacro:property name="base_length" value="0.5"/>
  <xacro:property name="base_width"  value="0.3"/>
  <xacro:property name="base_height" value="0.2"/>
  <xacro:property name="base_mass"   value="5.0"/>
  <!-- Govdenin merkezinin base_link'e gore yuksekligi.
       0.20 -> govdenin alti yerden 10 cm yukarida: parkurdaki 6 cm'lik dik engel
       (sartname 15 cm x 0.4), tumsekler ve rampalarda govde surtmez. -->
  <xacro:property name="base_z"      value="0.20"/>

  <!-- Tekerlek yaricapi 12 cm: bir tekerlek pratikte yaricapinin yarisi kadar yuksek bir
       basamaga tirmanabilir; 6 cm'lik dik engel icin en az 12 cm gerekir. -->
  <xacro:property name="wheel_radius" value="0.12"/>
  <xacro:property name="wheel_length" value="0.04"/>
  <xacro:property name="wheel_mass"   value="0.5"/>
  <!-- Tekerleklerin base_link'e gore konumu -->
  <xacro:property name="wheel_x" value="0.16"/>
  <xacro:property name="wheel_y" value="0.17"/>
  <xacro:property name="wheel_z" value="${wheel_radius}"/>

  <xacro:include filename="$(find ugv_description)/urdf/inertial_macros.xacro"/>
  <xacro:include filename="$(find ugv_description)/urdf/lidar.xacro"/>
  <xacro:include filename="$(find ugv_description)/urdf/camera.xacro"/>
  <xacro:include filename="$(find ugv_description)/urdf/aim_turret.xacro"/>
  <xacro:include filename="$(find ugv_description)/urdf/ugv.gazebo.xacro"/>

  <!-- ================= Malzemeler ================= -->
  <material name="blue">
    <color rgba="0.1 0.3 0.9 1.0"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>
  <material name="gray">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <!-- ================= Govde ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_length} ${base_width} ${base_height}"/>
      </geometry>
    </collision>
    <xacro:box_inertia m="${base_mass}" x="${base_length}" y="${base_width}" z="${base_height}"
                       xyz="0 0 ${base_z}"/>
  </link>

  <!-- ================= Tekerlekler ================= -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
        <material name="black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
      <xacro:wheel_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_length}"/>
    </link>

    <joint name="${name}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${name}_wheel"/>
      <origin xyz="${x} ${y} ${wheel_z}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${name}_wheel">
      <mu1>1.2</mu1>
      <mu2>1.2</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:wheel name="right_front" x="${wheel_x}"  y="${-wheel_y}"/>
  <xacro:wheel name="right_back"  x="${-wheel_x}" y="${-wheel_y}"/>
  <xacro:wheel name="left_front"  x="${wheel_x}"  y="${wheel_y}"/>
  <xacro:wheel name="left_back"   x="${-wheel_x}" y="${wheel_y}"/>

  <!-- ================= Sensorler ================= -->
  <!-- LIDAR on tamponda, yerden 20 cm: parkurdaki koniler (31 cm), kayar engel ve bariyerler
       (32 cm) tarama duzleminin icinde kalir. -->
  <xacro:lidar parent="base_link" xyz="${base_length/2 + 0.05} 0 ${base_z}"/>

  <!-- Surus kameralari (sartname 6.12: ileri ve geri surus kamerasi) -->
  <xacro:camera short="front" parent="base_link" hfov="1.2"
                xyz="${base_length/2 - 0.03} 0 ${base_z + base_height/2 + 0.0125}" rpy="0 0 0"/>
  <xacro:camera short="rear" parent="base_link" hfov="1.2"
                xyz="${-base_length/2 - 0.01} 0 ${base_z}" rpy="0 0 ${pi}"/>

  <!-- Nisan tareti + nisan kamerasi + lazer (LIDAR'in arkasinda) -->
  <xacro:aim_turret parent="base_link" x="-0.15" z_base="${base_z + base_height/2}"/>

  <!-- ================= Gazebo eklentileri ================= -->
  <xacro:ugv_gazebo wheel_separation="${2*wheel_y}" wheel_radius="${wheel_radius}"
                    cmd_vel_topic="$(arg cmd_vel_topic)"/>

</robot>
