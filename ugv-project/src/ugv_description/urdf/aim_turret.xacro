<?xml version="1.0"?>
<!--
  Nisan tareti: sabit direk + pan (yatay donus) + tilt (dikey egilme) eklemleri.
  Tilt kafasinda dar acili nisan kamerasi ve lazer isaretleyici bulunur (sartname 6.12).

  Komut (radyan):
      ros2 topic pub -1 /aim/pan_cmd  std_msgs/msg/Float64 "{data: 0.5}"
      ros2 topic pub -1 /aim/tilt_cmd std_msgs/msg/Float64 "{data: -0.1}"
  Gazebo'da da ayni topic adlari kullanilir (<topic> etiketi), kopru bunlari birebir baglar.
  Not: Gazebo'nun varsayilan adi (/model/ugv/joint/.../0/cmd_pos) icinde rakamla baslayan
  bir parca oldugu icin ROS'ta yeniden adlandirilamiyor; bu yuzden topic'i burada veriyoruz.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="aim_turret" params="parent x z_base mast_height:=0.10">

    <!-- Direk -->
    <link name="aim_mast_link">
      <visual>
        <origin xyz="0 0 ${mast_height/2}"/>
        <geometry><cylinder radius="0.015" length="${mast_height}"/></geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${mast_height/2}"/>
        <geometry><cylinder radius="0.015" length="${mast_height}"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="0.05" r="0.015" h="${mast_height}"/>
    </link>
    <joint name="aim_mast_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="aim_mast_link"/>
      <origin xyz="${x} 0 ${z_base}"/>
    </joint>

    <!-- Pan: z ekseni etrafinda donus -->
    <link name="aim_pan_link">
      <visual>
        <origin xyz="0 0 0.01"/>
        <geometry><cylinder radius="0.025" length="0.02"/></geometry>
        <material name="gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 0.01"/>
        <geometry><cylinder radius="0.025" length="0.02"/></geometry>
      </collision>
      <xacro:cylinder_inertia m="0.1" r="0.025" h="0.02"/>
    </link>
    <joint name="aim_pan_joint" type="revolute">
      <parent link="aim_mast_link"/>
      <child link="aim_pan_link"/>
      <origin xyz="0 0 ${mast_height}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-0.9*pi}" upper="${0.9*pi}" effort="2.0" velocity="2.0"/>
      <dynamics damping="0.01"/>
    </joint>

    <!-- Tilt: y ekseni etrafinda egilme (pozitif = asagi) -->
    <link name="aim_tilt_link">
      <visual>
        <geometry><box size="0.06 0.05 0.04"/></geometry>
        <material name="blue"/>
      </visual>
      <collision>
        <geometry><box size="0.06 0.05 0.04"/></geometry>
      </collision>
      <xacro:box_inertia m="0.1" x="0.06" y="0.05" z="0.04"/>
    </link>
    <joint name="aim_tilt_joint" type="revolute">
      <parent link="aim_pan_link"/>
      <child link="aim_tilt_link"/>
      <origin xyz="0 0 0.04"/>
      <axis xyz="0 1 0"/>
      <limit lower="-0.6" upper="0.6" effort="2.0" velocity="2.0"/>
      <dynamics damping="0.01"/>
    </joint>

    <!-- Nisan kamerasi: dar gorus acisi (~14 derece) uzaktaki hedef icin -->
    <xacro:camera short="aim" parent="aim_tilt_link" xyz="0.04 0 0.008" rpy="0 0 0"
                  hfov="0.25" rate="15"/>

    <!-- Lazer isaretleyici (simdilik sadece gorsel; isin cikis noktasi = laser_link) -->
    <link name="laser_link">
      <visual>
        <origin xyz="0.005 0 0" rpy="0 ${pi/2} 0"/>
        <geometry><cylinder radius="0.006" length="0.03"/></geometry>
        <material name="red">
          <color rgba="0.9 0.05 0.05 1.0"/>
        </material>
      </visual>
      <xacro:cylinder_inertia m="0.01" r="0.006" h="0.03"/>
    </link>
    <joint name="laser_joint" type="fixed">
      <parent link="aim_tilt_link"/>
      <child link="laser_link"/>
      <origin xyz="0.03 0 -0.012"/>
    </joint>

    <!-- Pozisyon kontrolculeri (PID, kuvvet tabanli) -->
    <gazebo>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>aim_pan_joint</joint_name>
        <topic>/aim/pan_cmd</topic>
        <p_gain>2.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.05</d_gain>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
      </plugin>
    </gazebo>
    <gazebo>
      <plugin filename="ignition-gazebo-joint-position-controller-system"
              name="ignition::gazebo::systems::JointPositionController">
        <joint_name>aim_tilt_joint</joint_name>
        <topic>/aim/tilt_cmd</topic>
        <p_gain>2.0</p_gain>
        <i_gain>0.0</i_gain>
        <d_gain>0.05</d_gain>
        <cmd_max>2.0</cmd_max>
        <cmd_min>-2.0</cmd_min>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
