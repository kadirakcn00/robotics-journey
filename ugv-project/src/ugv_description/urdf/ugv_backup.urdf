<?xml version="1.0" encoding="UTF-8"?>
<robot name="ugv">
            <material name="Green">
                <color rgba="0.0 1.0 0.0 1.0"/>
            </material>
            <material name="Red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
            <material name="Blue">
                <color rgba="0.0 0.0 1.0 1.0"/>
            </material>
    <link name="base_link">
        <visual>
            <material name="Red"/>
            <geometry>
                <box size="0.5 0.3 0.2"/>
            </geometry>
            <origin xyz="0.0 0.0 0.17" rpy="0.0 0.0 0.0"/>

        </visual>
            <collision>
                <geometry>
                <box size="0.5 0.3 0.2"/>                    
                </geometry>
                <origin xyz="0.0 0.0 0.17" rpy="0.0 0.0 0.0"/>
            </collision>        
    </link>
    
    <link name="right_back_wheel">
        <visual>
                <geometry>
                    <cylinder radius="0.07 " length="0.04"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
                <material name="Blue"/>
        </visual>
    <collision>
        <geometry>
            <cylinder radius="0.07" length="0.04"/>
        </geometry>

        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>        
        
    </link>

    <joint name="right_back_wheel_joint" type="continuous">
        <origin xyz="-0.16 -0.17 0.07" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="right_back_wheel"/>
        <axis xyz="0 1 0"/>
    </joint>

    <link name="right_front_wheel">
        <visual>
                <geometry>
                    <cylinder radius="0.07 " length="0.04"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
                <material name="Blue"/>
        </visual>
    <collision>
        <geometry>
            <cylinder radius="0.07" length="0.04"/>
        </geometry>

        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>        
        
    </link>

    <joint name="right_front_wheel_joint" type="continuous">
        <origin xyz="0.16 -0.17 0.07" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="right_front_wheel"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>


    <link name="left_back_wheel">
        <visual>
                <geometry>
                    <cylinder radius="0.07 " length="0.04"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
                <material name="Blue"/>
        </visual>
    <collision>
        <geometry>
            <cylinder radius="0.07" length="0.04"/>
        </geometry>

        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>        
        
    </link>

    <joint name="left_back_wheel_joint" type="continuous">
        <origin xyz="-0.16 0.17 0.07" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="left_back_wheel"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>


        <link name="left_front_wheel">
        <visual>
                <geometry>
                    <cylinder radius="0.07 " length="0.04"/>
                </geometry>
                <origin xyz="0.0 0.0 0.0" rpy="1.5708 0.0 0.0"/>
                <material name="Blue"/>
        </visual>
    <collision>
        <geometry>
            <cylinder radius="0.07" length="0.04"/>
        </geometry>

        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    </collision>        
        
    </link>

    <joint name="left_front_wheel_joint" type="continuous">
        <origin xyz="0.16 0.17 0.07" rpy="0.0 0.0 0.0"/>
        <parent link="base_link"/>
        <child link="left_front_wheel"/>
        <axis xyz="0.0 1.0 0.0"/>
    </joint>

</robot>