<?xml version="1.0"?>
<!-- Basit geometriler icin atalet (inertia) makrolari -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Dikdortgen kutu: ixx = m/12 (y^2 + z^2) ... -->
  <xacro:macro name="box_inertia" params="m x y z xyz:='0 0 0'">
    <inertial>
      <origin xyz="${xyz}" rpy="0 0 0"/>
      <mass value="${m}"/>
      <inertia ixx="${m/12.0*(y*y + z*z)}" ixy="0" ixz="0"
               iyy="${m/12.0*(x*x + z*z)}" iyz="0"
               izz="${m/12.0*(x*x + y*y)}"/>
    </inertial>
  </xacro:macro>

  <!-- Ekseni z olan silindir -->
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12.0*(3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${m/12.0*(3*r*r + h*h)}" iyz="0"
               izz="${m/2.0*r*r}"/>
    </inertial>
  </xacro:macro>

  <!-- Tekerlek: ekseni y yonunde olan silindir -->
  <xacro:macro name="wheel_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m/12.0*(3*r*r + h*h)}" ixy="0" ixz="0"
               iyy="${m/2.0*r*r}" iyz="0"
               izz="${m/12.0*(3*r*r + h*h)}"/>
    </inertial>
  </xacro:macro>

</robot>
