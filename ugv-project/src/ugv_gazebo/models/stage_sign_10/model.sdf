<?xml version="1.0"?>
<sdf version="1.8">
  <model name="stage_sign_10">
    <static>true</static>
    <link name="link">
      <!-- Direk -->
      <collision name="pole_collision">
        <pose>0 0 0.125 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.25</length></cylinder></geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 0.125 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <!-- Tabela: on yuzu -x yonune bakar -->
      <collision name="board_collision">
        <pose>0 0 0.3750 0 0 0</pose>
        <geometry><box><size>0.005 0.2500 0.2500</size></box></geometry>
      </collision>
      <visual name="board_visual">
        <pose>0 0 0.3750 0 0 0</pose>
        <geometry><box><size>0.005 0.2500 0.2500</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://stage_sign_10/materials/textures/sign_10.png</albedo_map>
            <roughness>1.0</roughness>
            <metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
    </link>
  </model>
</sdf>
