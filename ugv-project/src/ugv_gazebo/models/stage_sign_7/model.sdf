<?xml version="1.0"?>
<sdf version="1.8">
  <model name="stage_sign_7">
    <static>true</static>
    <link name="link">
      <!-- Direk -->
      <collision name="pole_collision">
        <pose>0 0 0.125 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.25</length></cylinder></geometry>
      </collision>
      <visual name="pole_visual">
        <pose>0 0 0.125 0 0 0</pose>
        <geometry><cylinder><radius>0.01</radius><length>0.25</length></cylinder></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.3 0.3 0.3 1</diffuse></material>
      </visual>
      <!-- Tabela: on yuzu -x yonune bakar -->
      <collision name="board_collision">
        <pose>0 0 0.3750 0 0 0</pose>
        <geometry><box><size>0.005 0.2500 0.2500</size></box></geometry>
      </collision>
      <visual name="board_visual">
        <pose>0 0 0.3750 0 0 0</pose>
        <geometry><box><size>0.005 0.2500 0.2500</size></box></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <pbr><metal>
            <albedo_map>model://stage_sign_7/materials/textures/sign_7.png</albedo_map>
            <roughness>1.0</roughness>
            <metalness>0.0</metalness>
          </metal></pbr>
        </material>
      </visual>
      <!-- Arka kapak: gercek tabelanin arkasi bos. Kutu dokusu arka yuze de basildigi icin
           arka yuzu duz gri bir kapakla ortuyoruz (yoksa robot tabelalari arkadan da okur). -->
      <visual name="board_back">
        <pose>0.004 0 0.3750 0 0 0</pose>
        <geometry><box><size>0.004 0.2540 0.2540</size></box></geometry>
        <material><ambient>0.45 0.45 0.45 1</ambient><diffuse>0.45 0.45 0.45 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
