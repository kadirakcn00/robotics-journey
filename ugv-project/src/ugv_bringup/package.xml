<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_bringup</name>
  <version>0.0.0</version>
  <description>Top-level launch files (simulation, SLAM, navigation, perception, course) for the UGV</description>
  <maintainer email="kadirakcn444@gmail.com">kadir</maintainer>
  <license>TODO: License declaration</license>

  <exec_depend>ugv_gazebo</exec_depend>
  <exec_depend>ugv_slam</exec_depend>
  <exec_depend>ugv_navigation</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>ugv_control</exec_depend>
  <exec_depend>ugv_perception</exec_depend>
  <exec_depend>ugv_course</exec_depend>
  <exec_depend>ugv_teleop</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
