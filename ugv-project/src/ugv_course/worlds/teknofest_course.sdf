<?xml version="1.0"?>
<!--
  TEKNOFEST 2026 Insansiz Kara Araci yarisma parkuru (Sekil 1), olcek x 0.4.
  Bu dosya ugv_course/scripts/make_teknofest_course.py ile uretilir; elle duzenlemeyin.
  Robot baslangici: (7.5, 0) -x yonune bakar.
  Hizlanma parkuru: (-0.4, 9.5) +x yonune bakar.
-->
<sdf version="1.8">
  <world name="teknofest_course">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <!-- Yagmur icin parcacik sistemi -->
    <plugin filename="ignition-gazebo-particle-emitter2-system"
            name="ignition::gazebo::systems::ParticleEmitter2"/>

    <scene>
      <ambient>0.6 0.6 0.6 1</ambient>
      <background>0.7 0.8 0.9 1</background>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.4 -0.85</direction>
    </light>

    <!-- Havuzun tabani: yer duzlemi z = -0.16000000000000003. Diger her yer zemin bloklariyla z = 0. -->
    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -0.16000000000000003 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.35 0.3 0.25 1.0</ambient><diffuse>0.35 0.3 0.25 1.0</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="terrain">
      <static>true</static>
      <link name="link">
        <visual name="terrain_1_v"><pose>-0.4000 4.5000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>11.2000 19.0000 0.5000</size></box></geometry><material><ambient>0.45 0.55 0.4 1.0</ambient><diffuse>0.45 0.55 0.4 1.0</diffuse></material></visual><collision name="terrain_1_c"><pose>-0.4000 4.5000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>11.2000 19.0000 0.5000</size></box></geometry></collision>
        <visual name="terrain_2_v"><pose>13.3000 4.5000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>13.4000 19.0000 0.5000</size></box></geometry><material><ambient>0.45 0.55 0.4 1.0</ambient><diffuse>0.45 0.55 0.4 1.0</diffuse></material></visual><collision name="terrain_2_c"><pose>13.3000 4.5000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>13.4000 19.0000 0.5000</size></box></geometry></collision>
        <visual name="terrain_3_v"><pose>5.9000 -2.8000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>1.4000 4.4000 0.5000</size></box></geometry><material><ambient>0.45 0.55 0.4 1.0</ambient><diffuse>0.45 0.55 0.4 1.0</diffuse></material></visual><collision name="terrain_3_c"><pose>5.9000 -2.8000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>1.4000 4.4000 0.5000</size></box></geometry></collision>
        <visual name="terrain_4_v"><pose>5.9000 7.3000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>1.4000 13.4000 0.5000</size></box></geometry><material><ambient>0.45 0.55 0.4 1.0</ambient><diffuse>0.45 0.55 0.4 1.0</diffuse></material></visual><collision name="terrain_4_c"><pose>5.9000 7.3000 -0.2500 0.0000 0.0000 0.0000</pose><geometry><box><size>1.4000 13.4000 0.5000</size></box></geometry></collision>
      </link>
    </model>

